<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherits the Room Booking form view to integrate POS-related features
     such as POS invoice stat button and POS Orders tab with order details and total amount -->
    <record id="room_booking_view_form_inherit_hotel_pos" model="ir.ui.view">
        <field name="name">room.booking.view.form.inherit.hotel.pos</field>
        <field name="model">room.booking</field>
        <field name="inherit_id" ref="hotel_management_odoo.room_booking_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Add any header buttons if needed -->
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pos_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="pos_invoice_count == 0">
                    <field name="pos_invoice_count" widget="statinfo" string="POS Inv..."/>
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <field name="has_pos_orders" invisible="1"/>
                <field name="amount_total_pos" invisible="1"/>
                <field name="amount_total_combined" invisible="1"/>
                <page string="POS Orders" name="pos_orders" invisible="not has_pos_orders">
                    <field name="pos_order_line_ids" readonly="1">
                        <list>
                            <field name="pos_order_id" string="Order Ref"/>
                            <field name="session_id"/>
                            <field name="date_order"/>
                            <field name="pos_reference" string="Receipt Number"/>
                            <field name="partner_id"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="amount_total" sum="Total POS Amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state in ('paid', 'invoiced', 'done') and not due_until_settle" decoration-warning="due_until_settle" decoration-muted="state == 'cancel'"/>
                            <field name="due_until_settle" string="Due At Checkout" widget="boolean_toggle"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <field name="amount_total_pos" widget="monetary"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//group[field[@name='amount_total']]" position="inside">
                <field name="amount_total_pos" widget="monetary"
                       string="POS Total" invisible="not has_pos_orders"/>
                <field name="amount_total_combined" widget="monetary"
                       string="Combined Total" invisible="not has_pos_orders"/>
            </xpath>
        </field>
    </record>
    <!-- Cards/lists show Combined Total (quote + POS), the same bottom
         line the form shows. Lives here (not base) because
         amount_total_combined is defined by this module: base views
         cannot reference dependent-module fields. -->
    <record id="room_booking_view_tree_inherit_hotel_pos" model="ir.ui.view">
        <field name="name">room.booking.view.tree.inherit.hotel.pos</field>
        <field name="model">room.booking</field>
        <field name="inherit_id"
               ref="hotel_management_odoo.room_booking_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="replace">
                <field name="amount_total_combined" string="Total"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>
    <record id="room_booking_view_kanban_inherit_hotel_pos" model="ir.ui.view">
        <field name="name">room.booking.view.kanban.inherit.hotel.pos</field>
        <field name="model">room.booking</field>
        <field name="inherit_id"
               ref="hotel_management_odoo.room_booking_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="/kanban/field[@name='amount_total']"
                   position="replace">
                <field name="amount_total_combined"/>
            </xpath>
            <xpath expr="//t[@t-name='card']//field[@name='amount_total']"
                   position="replace">
                <field name="amount_total_combined" string="Total"
                       widget="monetary"/>
            </xpath>
        </field>
    </record>
</odoo>
