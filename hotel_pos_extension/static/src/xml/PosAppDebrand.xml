<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- POS app (cashier UI): replace the default Odoo logo with the POS config logo -->
    <t t-name="hotel_pos_extension.NavbarDebrand" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-logo')]" position="replace">
            <img t-att-src="'/web/image/pos.config/' + this.pos.config.id + '/logo'" alt="Logo" class="mh-100 mw-100" style="object-fit: contain; max-height: 100%;"/>
        </xpath>
    </t>
    <!-- POS lock screen: same replacement -->
    <t t-name="hotel_pos_extension.SaverScreenDebrand" t-inherit="point_of_sale.SaverScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-logo')]" position="replace">
            <img t-att-src="'/web/image/pos.config/' + this.pos.config.id + '/logo'" alt="Logo" class="w-50" style="max-height: 25vh; object-fit: contain;"/>
        </xpath>
    </t>
</templates>
