<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Receipt content extras: M-Pesa till notice + vendor credit.
         Applies to both Bill (pro forma, draft orders) and final Receipt:
         both render point_of_sale.pos_order_receipt, whose footer this
         extends. Core classes only (text-normal/text-small/text-bold),
         so the 72mm scaling override keeps applying automatically. -->
    <template id="pos_order_receipt_footer_extras" inherit_id="point_of_sale.pos_order_receipt_footer" name="POS receipt M-Pesa + powered-by">
        <!-- M-Pesa paybill block, right after company info (KRA PIN etc.),
             always visible regardless of receipt_header/footer config. -->
        <xpath expr="//t[@t-call='point_of_sale.company_info_receipt']" position="after">
            <div class="w-100 text-center mt-2 mb-2" style="border-top: 1px dashed black; border-bottom: 1px dashed black; padding: 6px 0;">
                <div class="text-normal text-bold">M-PESA PAYBILL: 4141717</div>
                <div class="text-normal text-bold">ACCOUNT: CAMP DAVID UNITED</div>
            </div>
        </xpath>
        <!-- Small vendor credit appended at the very bottom of the ticket. -->
        <xpath expr="//div[hasclass('w-100','text-center','mt-3')]" position="inside">
            <div class="w-100 text-center text-small" style="margin-top: 8px;">Powered by colorchase.co.ke</div>
        </xpath>
    </template>

    <!-- Hide the per-tax "Base <tax>" row (e.g. "Base VAT 16%") from the
         totals table. The base usually equals the Subtotal and confuses
         customers; the "VAT 16%: <amount>" row already states the tax.
         Assumes core layout: inside t[name='taxes_foreach'] the first tr
         is the tax-amount line and the second tr is the base line. -->
    <template id="pos_order_receipt_hide_tax_base" inherit_id="point_of_sale.pos_order_receipt" name="POS receipt hide tax base row">
        <xpath expr="//t[@name='taxes_foreach']/tr[2]" position="replace"/>
    </template>

    <!-- Dashed divider between the totals block and the payment lines
         (inside the same prices table, so it needs a real row, not CSS).
         Shown only when payment lines exist; lands after TOTAL/Discount. -->
    <template id="pos_order_receipt_payments_separator" inherit_id="point_of_sale.pos_order_receipt" name="POS receipt payments divider">
        <xpath expr="//t[@name='payments']" position="before">
            <tr t-if="payments" class="receipt-payments-separator"><td colspan="2"></td></tr>
        </xpath>
    </template>

    <!-- Dashed divider between the header block and the order lines, so
         every major section boundary on the ticket carries a rule:
         header | lines | totals | payments | footer. -->
    <template id="pos_order_receipt_header_separator" inherit_id="point_of_sale.pos_order_receipt" name="POS receipt header divider">
        <xpath expr="//t[@t-call='point_of_sale.pos_order_receipt_header']" position="after">
            <div class="w-100 receipt-section-separator"></div>
        </xpath>
    </template>
</odoo>
