<?xml version="1.0" encoding="utf-8"?>
<odoo>
      <!--
        Preparation time for the POS Kitchen Screen.
        Template form: the default every staff member can reach, value
        applies to all variants unless a variant overrides it.
        Variant form: per-variant override, same tab spot.-->
    <record id="product_template_view_form_inherit_kitchen" model="ir.ui.view">
        <field name="name">product.template.form.inherit.pos.kitchen.screen.odoo</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Kitchen Preparation">
                    <field name="prepair_time_minutes"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="product_product_view_form_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit.pos.kitchen.screen.odoo</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group string="Kitchen Preparation">
                    <field name="prepair_time_minutes"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
