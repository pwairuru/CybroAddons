<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Hotel Services Tree View-->
    <record id="hotel_service_view_tree" model="ir.ui.view">
        <field name="name">hotel.service.view.tree</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="unit_price"/>
                <field name="taxes_ids" widget="many2many_tags"/>
                <field name="product_id" readonly="1"/>
            </list>
        </field>
    </record>
    <!--    Hotel Services Form View-->
    <record id="hotel_service_view_form" model="ir.ui.view">
        <field name="name">hotel.service.view.form</field>
        <field name="model">hotel.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <header>
                    <button name="action_open_product" type="object"
                            string="Open Product" class="oe_highlight"/>
                    <button name="action_view_hotel_sales" type="object"
                            string="Hotel Sales"/>
                </header>
                <sheet>
                    <group string="Service">
                        <field name="name"/>
                        <field name="unit_price"/>
                        <field name="taxes_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Sellable Product (Sales / Invoicing)">
                        <field name="product_id" readonly="1"/>
                        <field name="hotel_sold_qty" readonly="1"/>
                        <field name="hotel_revenue" readonly="1"/>
                        <div class="text-muted">Auto-created as a service-type product; price, name and taxes stay in sync. Hotel Sold counts folio postings (product Sold counts Sales orders only).</div>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--    Services Menu Action-->
    <record id="hotel_service_action" model="ir.actions.act_window">
        <field name="name">Services</field>
        <field name="res_model">hotel.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                No Services found ! Let's create one
            </p>
        </field>
    </record>
    <!--    Services Menu-->
    <menuitem id="hotel_service_menu"
              name="Services"
              action="hotel_service_action"
              parent="hotel_config_menu"
              sequence="40"/>
</odoo>
