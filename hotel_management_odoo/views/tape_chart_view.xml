<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Full tape chart client action. No separate menu: opened via
         Dashboard expand button (openTapeFull). -->
    <record id="hotel_tape_chart_action" model="ir.actions.client">
        <field name="name">Tape Chart</field>
        <field name="tag">hotel_tape_chart</field>
    </record>
    <!-- Delete menu orphan from earlier versions: removing menuitem XML
         alone never drops the DB row on -u, so delete explicitly. -->
    <delete model="ir.ui.menu" id="hotel_tape_chart_menu"/>
</odoo>
