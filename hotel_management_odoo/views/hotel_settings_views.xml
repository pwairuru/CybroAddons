<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hotel_settings_view_form" model="ir.ui.view">
        <field name="name">hotel.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Hotel" name="hotel_management_odoo">
                    <block title="Room Capacity" name="hotel_capacity">
                        <setting string="Over-capacity policy" help="How to handle a room line where adults + children exceed the room capacity.">
                            <field name="hotel_capacity_policy"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_hotel_settings" model="ir.actions.act_window">
        <field name="name">Hotel Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="hotel_settings_menu"
              name="Settings"
              parent="hotel_config_menu"
              action="action_hotel_settings"
              sequence="99"/>
</odoo>
