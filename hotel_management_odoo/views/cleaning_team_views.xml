<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
       <!--        Cleaning Team Tree View-->
    <record id="cleaning_team_view_tree" model="ir.ui.view">
        <field name="name">cleaning.team.view.tree</field>
        <field name="model">cleaning.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_head_id"/>
                <field name="area"/>
            </list>
        </field>
    </record>
    <record id="cleaning_team_view_kanban" model="ir.ui.view">
        <field name="name">cleaning.team.view.kanban</field>
        <field name="model">cleaning.team</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="avatar_128"/>
                <field name="team_head_id"/>
                <field name="area"/>
                <field name="max_rooms_per_day"/>
                <templates>
                    <t t-name="card">
                        <t t-call="hotel_management_odoo.hotel_kanban_card_shell">
                            <t t-set="avatar">
                                <field name="avatar_128" widget="image"
                                       class="o_kanban_avatar me-2"
                                       style="width:64px;height:64px;"/>
                            </t>
                                <div class="oe_kanban_record_heading">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div>
                                    Head:
                                    <field name="team_head_id"/>
                                </div>
                                <div class="text-muted">
                                    <field name="area"/>
                                </div>
                        </t>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--        Cleaning Team Form View-->
    <record id="cleaning_team_view_form" model="ir.ui.view">
        <field name="name">cleaning.team.view.form</field>
        <field name="model">cleaning.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="4">
                        <field name="name"/>
                        <field name="team_head_id"/>
                    </group>
                    <notebook>
                        <page string="Members">
                            <field name="member_ids">
                                <kanban>
                                    <field name="name"/>
                                    <field name="phone"/>
                                    <field name="image_1920"/>
                                    <templates>
                                        <t t-name="card">
                                            <div t-attf-class="oe_kanban_global_click">
                                                <div class="oe_kanban_image">
                                                    <field name="image_1920"
                                                           widget="image"
                                                           class="oe_avatar"/>
                                                </div>
                                                <div class="oe_kanban_details ml8">
                                                    <div class="oe_kanban_record_heading">
                                                        <strong>
                                                            <field name="name"/>
                                                            <br/>
                                                            <field name="phone"/>
                                                        </strong>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--    Cleaning Team Menu Action-->
    <record id="cleaning_team_action" model="ir.actions.act_window">
        <field name="name">Cleaning Team</field>
        <field name="res_model">cleaning.team</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
    </record>
    <!-- REMOVED per 2026-10-29 Task 7: Cleaning hidden.
    <menuitem id="hotel_config_menu_cleaning"
              name="Cleaning"
              parent="hotel_config_menu" sequence="186"/>
    <menuitem id="cleaning_team_menu"
              name="Cleaning Team"
              parent="hotel_config_menu_cleaning"
              action="cleaning_team_action"/>
    -->
</odoo>
