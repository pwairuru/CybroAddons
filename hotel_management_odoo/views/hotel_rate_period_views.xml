<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hotel_rate_period_view_search" model="ir.ui.view">
        <field name="name">hotel.rate.period.view.search</field>
        <field name="model">hotel.rate.period</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <separator/>
                <filter name="active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="hotel_rate_period_view_list" model="ir.ui.view">
        <field name="name">hotel.rate.period.view.list</field>
        <field name="model">hotel.rate.period</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="start_md"/>
                <field name="end_md"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hotel_rate_period_view_form" model="ir.ui.view">
        <field name="name">hotel.rate.period.view.form</field>
        <field name="model">hotel.rate.period</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Period">
                            <field name="name"/>
                            <field name="start_md"/>
                            <field name="end_md"/>
                            <field name="sequence"/>
                            <field name="priority"/>
                            <field name="applies_year"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Meal Lines">
                            <field name="meal_line_ids" create="0" delete="0">
                                <list editable="bottom">
                                    <field name="meal_plan_id" readonly="1"/>
                                    <field name="rate_type"/>
                                    <field name="value"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_rate_period_action" model="ir.actions.act_window">
        <field name="name">Rate Periods</field>
        <field name="res_model">hotel.rate.period</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="hotel_rate_period_menu"
              name="Rate Periods"
              sequence="15"
              parent="hotel_menu_pricing"
              action="hotel_rate_period_action"/>
</odoo>
