<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--     Room Booking Form View -->
    <record id="room_booking_view_form" model="ir.ui.view">
        <field name="name">room.booking.view.form</field>
        <field name="model">room.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reserve" string="Reserve"
                            invisible="state != 'draft'" type="object"
                            class="btn-primary"/>
                    <button name="action_print_combined_bill" string="PRINT BILL"
                            invisible="state not in ['check_in', 'check_out', 'done']"
                            type="object"/>
                    <button name="hotel_management_odoo.hotel_post_stay_action" string="Post Stay"
                            invisible="state not in ['reserved', 'check_in']"
                            type="action"
                            context="{'default_booking_id': id}"/>
                    <button name="action_checkin" string="Check-In"
                            class="btn-primary"
                            invisible="state != 'reserved'"
                            type="object"/>
                    <button name="action_maintenance_request"
                            string="Maintenance Request" type="object"
                            invisible=" maintenance_request_sent == True or ( state not in ['check_in', 'reserved'])"/>
                    <button name="action_checkout" string="Check-Out"
                            class="btn-primary" invisible="state != 'check_in'"
                            type="object"/>
                    <button name="action_charge_ancillaries"
                            string="Charge Ancillaries" type="object"
                            invisible="state != 'check_in'"/>
                    <button name="action_register_payment" string="Register Payment" type="object"
                             class="btn-primary" invisible="state != 'check_out' or amount_due == 0"/>
                    <button name="action_done" string="Set as Done"
                            class="btn-primary"
                            invisible="state != 'check_out'" type="object"/>
                    <button name="action_reopen" string="Back to Check-In" type="object"
                            invisible="state != 'check_out'"/>
                    <button name="action_invoice" string="Create Invoice"
                            type="object" class="btn-primary"
                            invisible="1"/>
                    <button name="action_cancel" string="Cancel"
                            invisible="state not in ['draft','reserved']"
                            type="object" class="btn-secondary"/>
                    <field name="state" select="2" widget="statusbar"
                           statusbar_visible="draft,check_in,check_out,done"/>
                    <field name="invoice_status" select="2" widget="statusbar"/>
                </header>
                <sheet>
                    <div name="button_box" position="inside">
                        <button class="oe_stat_button" type="object"
                                 name="action_view_invoices"
                                 icon="fa-edit">
                            <field string="Invoices" name="amount_invoiced"
                                   widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_payments"
                                icon="fa-money">
                            <field string="Payments" name="amount_paid" widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_folio"
                                icon="fa-bed">
                            <field string="Folios" name="folio_count"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <div>
                        <h1>
                            <field name="name" colspan="4"/>
                        </h1>
                    </div>
                    <group>
                        <!-- Invisible Fields -->
                        <field name="is_checkin" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="has_pos_orders" invisible="1"/>
                        <field name="checkin_date" invisible="1"/>
                        <field name="checkout_date" invisible="1"/>
                        <field name="actual_checkout_date" invisible="1"/>
                        <field name="duration" readonly="1" invisible="1"/>
                        <field name="invoice_button_visible" invisible="1"/>
                        <field name="maintenance_request_sent" invisible="1"/>
                        <group>
                            <field name="partner_id"
                                    widget="res_partner_many2one"
                                    context="{'res_partner_search_mode': 'customer', 'show_address': 1, 'show_vat': True}"
                                    options="{'always_reload': True}"/>
                            <field name="invoice_address_id"
                                    domain="[('parent_id','=',partner_id)]"
                                    context="{'default_type':'invoice'}"
                                    options="{'always_reload': True}"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                            <field name="pricelist_id"/>
                            <field name="hotel_policy"/>
                            <field name="need_service"
                                    invisible=" state not in ('draft','reserved','check_in')"/>
                            <field name="need_fleet"
                                   invisible=" state not in ('draft','reserved','check_in')"/>
                            <field name="need_food"
                                   invisible=" state not in ('draft','reserved','check_in')"/>
                            <field name="need_event"
                                   invisible=" state not in ('draft','reserved','check_in')"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="folio" string="Folio">
                            <field name="room_line_ids" colspan="4"
                                    string="Room Lines"
                                    context="{'default_checkin_date':checkin_date, 'default_checkout_date':checkout_date}">
                                <list editable="bottom">
                                    <field name="room_id" string="Room"
                                            required="1"
                                            domain="[('is_room','=',True)]"
                                            options="{'no_open': True, 'no_create': True}"/>
                                    <field name="checkin_date"/>
                                    <field name="booking_line_visible"
                                            invisible="1"/>
                                    <field name="locked" invisible="1"/>
                                    <field name="checkout_date"/>
                                    <field name="uom_qty" string="Duration"
                                            readonly="1" force_save="1"/>
                                    <field name="adults" string="Adults"/>
                                    <field name="children" string="Children"/>
                                    <field name="toddlers" string="Toddlers"/>
                                    <field name="uom_id"
                                            readonly="1"
                                            string="Unit of Measure"
                                            options="{'no_open': True, 'no_create': True}"/>
                                    <field name="price_unit"
                                            readonly="locked == True"/>
                                    <field name="tax_ids"
                                            readonly="locked == True"
                                            options="{'no_create': True}"
                                            widget="many2many_tags"/>
                                    <field name="price_subtotal"
                                           widget="monetary"
                                           readonly="booking_line_visible == True"/>
                                    <field groups="account.group_account_manager"
                                           name="price_total" widget="monetary"
                                           readonly="booking_line_visible == True"/>
                                    <field name="extra_per_night" widget="monetary"/>
                                    <field name="extra_stay_total" widget="monetary"/>
                                </list>
                            </field>
                            <div class="oe_clear"/>
                        </page>
                        <page name="food" string="Food"
                              invisible="need_food == False ">
                            <field name="food_order_line_ids" colspan="4" string="Food Lines"/>
                            <group colspan="2"
                                   class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed_food"
                                       sum="Untaxed amount for Food"
                                       widget="monetary"/>
                                <field name="amount_taxed_food"
                                       widget="monetary"/>
                                <label for="amount_total_food"/>
                                <field name="amount_total_food" nolabel="1"
                                       sum="Total amount" widget="monetary"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page name="service" string="Service"
                              invisible="need_service == False">
                            <field name="service_line_ids" colspan="4" string="Service Lines"/>
                            <group colspan="2"
                                   class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed_service"
                                       sum="Untaxed amount for Service"
                                       widget="monetary"/>
                                <field name="amount_taxed_service"
                                       widget="monetary"/>
                                <label for="amount_total_service"/>
                                <field name="amount_total_service" nolabel="1"
                                       sum="Total amount" widget="monetary"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page name="fleet" string="Fleet"
                              invisible="need_fleet == False">
                            <field name="vehicle_line_ids" colspan="4" string="Fleet Lines"/>
                            <group colspan="2"
                                   class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed_fleet"
                                       sum="Untaxed amount for Fleet"
                                       widget="monetary"/>
                                <field name="amount_taxed_fleet"
                                       widget="monetary"/>
                                <label for="amount_total_fleet"/>
                                <field name="amount_total_fleet" nolabel="1"
                                       sum="Total amount" widget="monetary"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                        <page name="event" string="Events"
                              invisible=" need_event == False ">
                            <field name="event_line_ids" colspan="4" string="Event Lines"/>
                            <group colspan="2"
                                   class="oe_subtotal_footer oe_right">
                                <field name="amount_untaxed_event"
                                       sum="Untaxed amount for Event"
                                       widget="monetary"/>
                                <field name="amount_taxed_event"
                                       widget="monetary"/>
                                <label for="amount_total_event"/>
                                <field name="amount_total_event" nolabel="1"
                                       sum="Total amount" widget="monetary"/>
                            </group>
                            <div class="oe_clear"/>
                        </page>
                    </notebook>
                    <!-- Booking summary at end of form: same right-side
                         footer position/styling as before, out of the
                         way of the line tabs. -->
                    <group name="booking_summary" colspan="2"
                           class="oe_subtotal_footer oe_right">
                        <div colspan="2" class="text-end fw-bold">Charges<hr class="ms-auto my-1" style="width: 40%;"/></div>
                        <field name="amount_untaxed_room"
                               sum="Untaxed amount for Room"
                               widget="monetary"/>
                        <field name="amount_untaxed_food"
                               sum="Untaxed amount for Food"
                               widget="monetary"
                               invisible="need_food == False"/>
                        <field name="amount_untaxed_service"
                               sum="Untaxed amount for Service"
                               widget="monetary"
                               invisible="need_service == False"/>
                        <field name="amount_untaxed_fleet"
                               sum="Untaxed amount for Fleet"
                               widget="monetary"
                               invisible="need_fleet == False"/>
                        <field name="amount_untaxed_event"
                               sum="Untaxed amount for Event"
                               widget="monetary"
                               invisible="need_event == False"/>
                        <div colspan="2" class="text-end fw-bold mt-1">Totals<hr class="ms-auto my-1" style="width: 40%;"/></div>
                        <field name="amount_untaxed"
                               sum="Untaxed amount" widget="monetary"/>
                        <field name="amount_tax" widget="monetary"/>
                        <label for="amount_total"/>
                        <field name="amount_total" nolabel="1"
                               sum="Total amount" widget="monetary"
                               help="Quote before folio posting"/>
                        <div colspan="2" class="text-end fw-bold mt-1">Payments<hr class="ms-auto my-1" style="width: 40%;"/></div>
                        <field name="amount_paid" widget="monetary"
                               class="text-success"/>
                        <field name="amount_due" widget="monetary"
                               class="text-danger"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!-- Isolate Bill in the cog menu (with Sale Order / Room Booking
         Order prints): same report, folio page + separate POS page. -->
    <record id="action_server_isolate_bill" model="ir.actions.server">
        <field name="name">Isolate Bill</field>
        <field name="model_id" ref="model_room_booking"/>
        <field name="binding_model_id" ref="model_room_booking"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_print_isolate_bill()</field>
    </record>
    <!--     Room Booking Tree view -->
    <record id="room_booking_view_tree" model="ir.ui.view">
        <field name="name">room.booking.view.tree</field>
        <field name="model">room.booking</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('draft', 'cancel', 'done')"
                  decoration-info="state == 'reserved'"
                  decoration-success="state == 'check_in'"
                  decoration-warning="state == 'check_out'">
                <field name="name" string="Reference"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="checkin_date"/>
                <field name="checkout_date"/>
                <field name="amount_total" widget="monetary"/>
                <field name="state" widget="badge"
                       decoration-muted="state in ('draft', 'cancel', 'done')"
                       decoration-info="state == 'reserved'"
                       decoration-success="state == 'check_in'"
                       decoration-warning="state == 'check_out'"
                       decoration-danger="state == 'cancel'"/>
                <button name="action_checkin" string="Check-In"
                        type="object" icon="fa-sign-in"
                        invisible="state != 'reserved'"/>
                <button name="action_checkout" string="Check-Out"
                        type="object" icon="fa-sign-out"
                        invisible="state != 'check_in'"/>
                <button name="action_view_folio" string="Folio"
                        type="object" icon="fa-bed"/>
            </list>
        </field>
    </record>
    <record id="room_booking_view_kanban" model="ir.ui.view">
        <field name="name">room.booking.view.kanban</field>
        <field name="model">room.booking</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="avatar_128"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="checkin_date"/>
                <field name="checkout_date"/>
                <field name="amount_total"/>
                <field name="amount_due"/>
                <field name="state"/>
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" class="dropdown-item"
                           type="object" name="action_reserve"
                           invisible="state != 'draft'">Reserve</a>
                        <a role="menuitem" class="dropdown-item"
                           type="object" name="action_checkin"
                           invisible="state != 'reserved'">Check-In</a>
                        <a role="menuitem" class="dropdown-item"
                           type="object" name="action_checkout"
                           invisible="state != 'check_in'">Check-Out</a>
                        <a role="menuitem" class="dropdown-item"
                           type="action"
                           name="%(hotel_management_odoo.hotel_post_stay_action)d"
                           invisible="state not in ['reserved', 'check_in']">Post Stay</a>
                        <a role="menuitem" class="dropdown-item"
                           type="object" name="action_view_folio">View Folio</a>
                        <a role="menuitem" class="dropdown-item"
                           type="object" name="action_print_combined_bill"
                           invisible="state not in ['check_in', 'check_out', 'done']">Combined Bill</a>
                        <a role="menuitem" class="dropdown-item"
                           type="object" name="action_print_isolate_bill"
                           invisible="state not in ['check_in', 'check_out', 'done']">Isolate Bill</a>
                        <a role="menuitem" class="dropdown-item"
                           type="action"
                           name="%(hotel_management_odoo.action_report_room_booking)d">Reservation Slip</a>
                        <div role="separator" class="dropdown-divider"></div>
                        <a role="menuitem" class="dropdown-item"
                           type="object" name="action_cancel"
                           invisible="state not in ['draft', 'reserved']">Cancel</a>
                    </t>
                    <t t-name="card">
                        <div class="oe_kanban_global_click d-flex">
                            <field name="avatar_128" widget="image"
                                   class="o_kanban_avatar me-2"
                                   style="width:64px;height:64px;"/>
                            <div class="oe_kanban_details flex-grow-1">
                                <div class="d-flex align-items-center">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span class="ms-2">
                                        <field name="state" widget="badge"
                                               decoration-muted="state in ('draft', 'cancel', 'done')"
                                               decoration-info="state == 'reserved'"
                                               decoration-success="state == 'check_in'"
                                               decoration-warning="state == 'check_out'"
                                               decoration-danger="state == 'cancel'"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="partner_id"/>
                                </div>
                                <div class="text-muted">
                                    <field name="checkin_date"/>
                                    →
                                    <field name="checkout_date"/>
                                </div>
                                <hr class="my-1" style="opacity: 0.12;"/>
                                <div class="d-flex justify-content-between">
                                    <span>Total:
                                        <strong>
                                            <field name="amount_total"
                                                   widget="monetary"/>
                                        </strong>
                                    </span>
                                    <span class="text-muted">Due:
                                        <strong>
                                            <field name="amount_due"
                                                   widget="monetary"/>
                                        </strong>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-end gap-1 mt-1">
                                    <button name="action_reserve"
                                            string="Reserve"
                                            type="object"
                                            class="btn btn-secondary btn-sm"
                                            invisible="state != 'draft'"/>
                                    <button name="action_checkin"
                                            string="Check-In"
                                            type="object"
                                            class="btn btn-primary btn-sm"
                                            invisible="state != 'reserved'"/>
                                    <button name="action_checkout"
                                            string="Check-Out"
                                            type="object"
                                            class="btn btn-primary btn-sm"
                                            invisible="state != 'check_in'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--     Room Booking Menu action -->
    <record id="room_booking_action" model="ir.actions.act_window">
        <field name="name">Room Booking</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">room.booking</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Book your rooms here!
            </p>
        </field>
    </record>
    <!--     Reservation menu -->
    <menuitem id="room_booking_menu" name="Reservation" sequence="10"
              parent="hotel_management_menu_root"
              action="room_booking_action"/>
    <!--     Leaf opening the booking view: navbar never fires parent-menu
          actions (see navbar.xml MenuSlot/SectionMenu), so a menu with
          children (Folios/Deposits/...) needs an explicit childless leaf. -->
    <menuitem id="room_booking_menu_all" name="Reservations" sequence="1"
              parent="room_booking_menu"
              action="room_booking_action"/>
</odoo>
