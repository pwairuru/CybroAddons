<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Main Menu (Hoteli: sequence -20 keeps Hotel first, ahead of HR/inventory dashboards)-->
    <menuitem id="hotel_management_menu_root"
              name="Hotel Management"
              web_icon="hotel_management_odoo,static/description/icon.png"
              sequence="-20"/>
    <!--    Configuration menu: managers + admins ONLY (Task 11).
            Reception/housekeeping/cashier/auditor never see masters.-->
    <menuitem id="hotel_config_menu"
              name="Configuration"
              sequence="50"
              groups="hotel_management_odoo.hotel_group_manager,hotel_management_odoo.hotel_group_admin"
              parent="hotel_management_menu_root"/>
    <delete model="ir.ui.menu" id="hotel_rack_menu"/>
    <!--    Task 5 groupings: Rooms / Pricing / Folio. Operational menus
         live here, never under Settings. Config stays as the existing
         Configuration menu (Boards/Amenities/Floors). -->
    <menuitem id="hotel_menu_rooms"
              name="Rooms"
              sequence="10"
              parent="hotel_management_menu_root"/>
    <menuitem id="hotel_menu_pricing"
              name="Pricing"
              sequence="11"
              parent="hotel_management_menu_root"/>
    <menuitem id="hotel_menu_folio"
              name="Folio"
              sequence="12"
              parent="hotel_management_menu_root"/>
    <!--    Rate Calendar placeholder: Task 5 reserved the slot; Task 6
          wires it to the calendar client action. -->
    <menuitem id="hotel_rate_calendar_menu"
              name="Rate Calendar"
              sequence="30"
              parent="hotel_menu_rooms"
              action="hotel_rate_calendar_action"/>
    <menuitem id="hotel_housekeeping_menu"
              name="Housekeeping"
              sequence="13"
              parent="hotel_management_menu_root"/>
    <menuitem id="hotel_cashier_menu"
              name="Cashier"
              sequence="14"
              parent="hotel_management_menu_root"/>
    <menuitem id="hotel_audit_menu"
              name="Audit"
              sequence="15"
              parent="hotel_management_menu_root"/>
    <!--    Food / Vehicle masters live under Configuration (Task 11)-->
    <menuitem id="food_menu"
              name="Food"
              sequence="20"
              parent="hotel_config_menu"/>
    <menuitem id="fleet_vehicle_menu"
              name="Vehicle"
              sequence="30"
              parent="hotel_config_menu"/>
</odoo>
