    <!-- Task 11: linen-type master lives under Configuration -->
    <record id="hotel_linen_type_action" model="ir.actions.act_window">
        <field name="name">Linen Types</field>
        <field name="res_model">hotel.linen.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- REMOVED per 2026-10-29 Task 7: Linen Types hidden.
    <menuitem id="hotel_linen_type_menu" name="Linen Types" sequence="43"
              parent="hotel_config_menu"
              action="hotel_linen_type_action"/>
    -->
</odoo>
