<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--    Dashboard Client action-->
    <record id="hotel_dashboard_action" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">custom_dashboard_tags</field>
    </record>
    <!--Menu Dashboard (Hoteli: first child, app opens on dashboard;
        POS cashiers work from the POS frontend only, so the hotel cashier
        role is explicitly unlinked here (menu group updates are additive,
        plain removal would not drop the old grant). -->
    <menuitem name="Dashboard" id="hotel_dashboard_menu"
              groups="hotel_management_odoo.hotel_group_reception,hotel_management_odoo.hotel_group_housekeeping,hotel_management_odoo.hotel_group_auditor,hotel_management_odoo.hotel_group_manager,hotel_management_odoo.hotel_group_admin,-hotel_management_odoo.hotel_group_cashier"
              parent="hotel_management_menu_root"
              sequence="1"
              action="hotel_dashboard_action"/>
</odoo>
