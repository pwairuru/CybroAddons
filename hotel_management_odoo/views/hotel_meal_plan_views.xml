<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="hotel_meal_plan_view_search" model="ir.ui.view">
        <field name="name">hotel.meal.plan.view.search</field>
        <field name="model">hotel.meal.plan</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter name="active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="hotel_meal_plan_view_list" model="ir.ui.view">
        <field name="name">hotel.meal.plan.view.list</field>
        <field name="model">hotel.meal.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="hotel_meal_plan_view_form" model="ir.ui.view">
        <field name="name">hotel.meal.plan.view.form</field>
        <field name="model">hotel.meal.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Plan">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_meal_plan_action" model="ir.actions.act_window">
        <field name="name">Meal Plans</field>
        <field name="res_model">hotel.meal.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--    Boards menu becomes Meal Plans; the old board-rule screen
          stays in the model/engine but is no longer a menu entry. -->
    <delete model="ir.ui.menu" id="hotel_board_rule_menu"/>

    <menuitem id="hotel_meal_plan_menu"
              name="Meal Plans"
              sequence="40"
              parent="hotel_config_menu"
              action="hotel_meal_plan_action"/>
</odoo>
