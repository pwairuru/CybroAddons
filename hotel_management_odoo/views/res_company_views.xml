<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_company_view_form_hotel_default_plan" model="ir.ui.view">
        <field name="name">res.company.view.form.hotel.default.plan</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="website" position="after">
                <field name="default_rate_plan_id"/>
                <group string="Room Capacity">
                    <field name="hotel_capacity_policy"/>
                </group>
                <group string="No-Show Policy">
                    <field name="no_show_policy"/>
                    <field name="no_show_fee_product_id"/>
                </group>
                <group string="M-Pesa">
                    <field name="mpesa_paybill_number" placeholder="e.g. 4141717"/>
                    <field name="mpesa_paybill_account" placeholder="e.g. CAMP DAVID UNITED"/>
                </group>
            </field>
        </field>
    </record>
</odoo>
