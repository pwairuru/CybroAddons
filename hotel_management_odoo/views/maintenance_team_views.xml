<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--Maintenance Team Form View-->
    <record id="maintenance_team_view_form" model="ir.ui.view">
        <field name="name">maintenance.team.view.form</field>
        <field name="model">maintenance.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_hotel" invisible="1"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Members">
                            <field name="member_ids" mode="kanban"
                                   options="{'no_edit': True, 'no_create': True, 'no_open': True}">
                                <kanban>
                                    <field name="image_1920"/>
                                    <field name="name"/>
                                    <templates>
                                        <t t-name="card">
                                            <div t-attf-class="oe_kanban_global_click">
                                                <div class="o_kanban_image">
                                                    <field name="image_1920"
                                                           widget='image'
                                                           class="oe_avatar"/>
                                                </div>
                                                <div class="oe_kanban_details ml8">
                                                    <div class="o_kanban_record_headings">
                                                        <strong>
                                                            <field name="name"/>
                                                        </strong>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <!--Maintenance Team Tree View-->
    <record id="maintenance_team_view_tree" model="ir.ui.view">
        <field name="name">maintenance.team.view.tree</field>
        <field name="model">maintenance.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>
    <record id="maintenance_team_view_kanban" model="ir.ui.view">
        <field name="name">maintenance.team.view.kanban</field>
        <field name="model">maintenance.team</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="avatar_128"/>
                <field name="user_id"/>
                <templates>
                    <t t-name="card">
                        <t t-call="hotel_management_odoo.hotel_kanban_card_shell">
                            <t t-set="avatar">
                                <field name="avatar_128" widget="image"
                                       class="o_kanban_avatar me-2"
                                       style="width:64px;height:64px;"/>
                            </t>
                                <div class="oe_kanban_record_heading">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div>
                                    Lead:
                                    <field name="user_id"/>
                                </div>
                        </t>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <!--    Maintenance Team Menu Action-->
    <record id="maintenance_team_action" model="ir.actions.act_window">
        <field name="name">Maintenance Team</field>
        <field name="res_model">maintenance.team</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_hotel', '=', True)]</field>
        <field name="context">{'default_is_hotel': True}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('maintenance_team_view_kanban')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('maintenance_team_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('maintenance_team_view_form')})]"/>
    </record>
    <!-- REMOVED per 2026-10-29 Task 7: Maintenance hidden.
    <menuitem id="maintenance_menu"
              name="Maintenance"
              parent="hotel_config_menu" sequence="185"/>
    <menuitem id="maintenance_team_menu"
              name="Maintenance Team"
              parent="maintenance_menu"
              action="maintenance_team_action"/>
    -->
</odoo>
