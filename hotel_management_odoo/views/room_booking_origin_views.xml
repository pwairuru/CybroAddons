<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="room_booking_origin_view_search" model="ir.ui.view">
        <field name="name">room.booking.origin.view.search</field>
        <field name="model">room.booking.origin</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter name="active" string="Active"
                        domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="room_booking_origin_view_list" model="ir.ui.view">
        <field name="name">room.booking.origin.view.list</field>
        <field name="model">room.booking.origin</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="room_booking_origin_view_form" model="ir.ui.view">
        <field name="name">room.booking.origin.view.form</field>
        <field name="model">room.booking.origin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Origin">
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="room_booking_origin_action" model="ir.actions.act_window">
        <field name="name">Booking Origins</field>
        <field name="res_model">room.booking.origin</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="room_booking_origin_menu"
              name="Booking Origins"
              sequence="45"
              parent="hotel_config_menu"
              action="room_booking_origin_action"/>
</odoo>
