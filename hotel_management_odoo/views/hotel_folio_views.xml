<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Task 7: folio/deposit/ledger menus live under Reservations
         (room_booking_menu); the Task-4 intermediate menu is removed
         at the end of this file, after its action menu moves. -->

    <record id="hotel_folio_view_list" model="ir.ui.view">
        <field name="name">hotel.folio.view.list</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'open'"
                  decoration-success="state == 'settled'"
                  decoration-muted="state == 'void'">
                <field name="name" string="Reference"/>
                <field name="partner_id"/>
                <field name="booking_id"/>
                <field name="policy_snapshot"/>
                <field name="amount_total"/>
                <field name="amount_due"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'open'"
                       decoration-success="state == 'settled'"
                       decoration-muted="state == 'void'"
                       decoration-danger="state == 'void'"/>
                <button name="action_register_payment" string="Pay"
                        type="object" icon="fa-money"
                        invisible="state != 'open'"/>
                <button name="action_settle" string="Settle"
                        type="object" icon="fa-check"
                        invisible="state != 'open'"/>
            </list>
        </field>
    </record>

    <record id="hotel_folio_view_kanban" model="ir.ui.view">
        <field name="name">hotel.folio.view.kanban</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="avatar_128"/>
                <field name="partner_id"/>
                <field name="booking_id"/>
                <field name="amount_total"/>
                <field name="amount_due"/>
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="position-relative">
                            <div class="o_dropdown_kanban dropdown position-absolute top-0 end-0 p-1">
                                <a class="dropdown-toggle o-no-caret btn btn-light btn-sm px-1 py-0"
                                   data-bs-toggle="dropdown" href="#"
                                   aria-label="Quick actions" title="Quick actions"
                                   role="button">
                                    <i class="fa fa-ellipsis-v text-muted"/>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end" role="menu">
                                    <a role="menuitem" class="dropdown-item"
                                       type="object" name="action_generate_draft_invoice"
                                       invisible="state != 'open'">Generate Draft</a>
                                    <a role="menuitem" class="dropdown-item"
                                       type="object" name="action_post_invoice"
                                       invisible="state != 'open'">Post Invoice</a>
                                    <a role="menuitem" class="dropdown-item"
                                       type="object" name="action_register_payment"
                                       invisible="state != 'open'">Register Payment</a>
                                    <a role="menuitem" class="dropdown-item"
                                       type="object" name="action_apply_deposit"
                                       invisible="state != 'open'">Apply Deposit</a>
                                    <a role="menuitem" class="dropdown-item"
                                       type="object" name="action_settle"
                                       invisible="state != 'open'">Settle</a>
                                    <a role="menuitem" class="dropdown-item"
                                       type="action"
                                       name="%(hotel_management_odoo.hotel_folio_split_action)d"
                                       invisible="state != 'open'">Split Bill</a>
                                    <a role="menuitem" class="dropdown-item"
                                       type="object" name="action_view_payments">View Payments</a>
                                    <a role="menuitem" class="dropdown-item"
                                       type="action"
                                       name="%(hotel_management_odoo.action_report_hotel_folio_statement)d">Folio Statement</a>
                                    <a role="menuitem" class="dropdown-item"
                                       type="object" name="action_void"
                                       invisible="state != 'open'">Void</a>
                                </div>
                            </div>
                        <div class="oe_kanban_global_click d-flex pe-4">
                            <field name="avatar_128" widget="image"
                                   class="o_kanban_avatar me-2"
                                   style="width:64px;height:64px;"/>
                            <div class="oe_kanban_details flex-grow-1">
                                <div class="d-flex align-items-center">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <span class="ms-2">
                                        <field name="state" widget="badge"
                                               decoration-info="state == 'open'"
                                               decoration-success="state == 'settled'"
                                               decoration-muted="state == 'void'"
                                               decoration-danger="state == 'void'"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_subtitle">
                                    <field name="partner_id"/>
                                </div>
                                <div class="text-muted">
                                    <field name="booking_id"/>
                                </div>
                                <hr class="my-1" style="opacity: 0.12;"/>
                                <div class="d-flex justify-content-between">
                                    <span>Total:
                                        <strong>
                                            <field name="amount_total"
                                                   widget="monetary"/>
                                        </strong>
                                    </span>
                                    <span class="text-muted">Due:
                                        <strong>
                                            <field name="amount_due"
                                                   widget="monetary"/>
                                        </strong>
                                    </span>
                                </div>
                                <div class="d-flex justify-content-end gap-1 mt-1">
                                    <button name="action_register_payment"
                                            string="Pay"
                                            type="object"
                                            class="btn btn-secondary btn-sm"
                                            invisible="state != 'open'"/>
                                    <button name="action_settle"
                                            string="Settle"
                                            type="object"
                                            class="btn btn-primary btn-sm"
                                            invisible="state != 'open'"/>
                                </div>
                            </div>
                        </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="hotel_folio_view_form" model="ir.ui.view">
        <field name="name">hotel.folio.view.form</field>
        <field name="model">hotel.folio</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_draft_invoice"
                            string="Generate Draft"
                            invisible="state != 'open'" type="object"/>
                    <button name="action_post_invoice" string="Post"
                            invisible="state != 'open'" type="object"/>
                    <button name="action_register_payment" string="Register Payment"
                             type="object"
                             invisible="state != 'open' or amount_due == 0"/>
                    <button name="action_apply_deposit"
                            string="Apply Deposit"
                            invisible="state != 'open'" type="object"/>
                    <button name="action_settle" string="Settle"
                             invisible="state != 'open'" type="object"
                             class="btn-primary"/>
                    <button name="hotel_management_odoo.hotel_folio_split_action"
                            string="Split Bill"
                            invisible="state != 'open'"
                            type="action"
                            context="{'default_folio_id': id}"/>
                    <button name="action_void" string="Void"
                            invisible="state != 'open'" type="object"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="open,settled,void"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_generate_draft_invoice"
                                icon="fa-file-text-o">
                            <field string="Invoices" name="invoice_ids"
                                   widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_payments"
                                icon="fa-money">
                            <field string="Payments" name="payment_ids"
                                   widget="statinfo"/>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_settle"
                                icon="fa-money">
                            <field string="Due" name="amount_due"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id"/>
                            <field name="booking_id"/>
                            <field name="policy_snapshot"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="deposit_total"/>
                            <field name="amount_paid" class="text-success"/>
                            <field name="amount_due" class="text-danger"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Charges">
                            <field name="line_ids"/>
                        </page>
                        <page string="POS">
                            <field name="line_ids"
                                   domain="[('source', '=', 'pos')]"/>
                        </page>
                        <page string="Payments">
                            <field name="payment_ids"/>
                        </page>
                        <page string="Invoices">
                            <field name="invoice_ids"/>
                        </page>
                        <page string="Notes">
                            <group>
                                <field name="notes"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_folio_line_view_list" model="ir.ui.view">
        <field name="name">hotel.folio.line.view.list</field>
        <field name="model">hotel.folio.line</field>
        <field name="arch" type="xml">
            <list>
                <field name="folio_id"/>
                <field name="product_id"/>
                <field name="quantity"/>
                <field name="price_unit"/>
                <field name="routing"/>
                <field name="source"/>
                <field name="pos_order_id"/>
                <field name="invoiced_qty"/>
                <field name="locked"/>
            </list>
        </field>
    </record>

    <record id="hotel_folio_action" model="ir.actions.act_window">
        <field name="name">Folios</field>
        <field name="res_model">hotel.folio</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <!-- Task 7: Folio merged into Reservations (room_booking_menu). -->
    <menuitem id="hotel_folio_menu_action"
              name="Folios"
              sequence="20"
              parent="room_booking_menu"
              action="hotel_folio_action"/>

    <record id="hotel_deposit_view_list" model="ir.ui.view">
        <field name="name">hotel.deposit.view.list</field>
        <field name="model">hotel.deposit</field>
        <field name="arch" type="xml">
            <list>
                <field name="folio_id"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="account_id"/>
            </list>
        </field>
    </record>

    <record id="hotel_deposit_view_form" model="ir.ui.view">
        <field name="name">hotel.deposit.view.form</field>
        <field name="model">hotel.deposit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_collect" string="Collect"
                            type="object" invisible="state != 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <field name="folio_id"/>
                        <field name="amount"/>
                        <field name="state"/>
                        <field name="payment_move_id" readonly="1"/>
                        <field name="company_id"/>
                        <field name="account_id"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_deposit_action" model="ir.actions.act_window">
        <field name="name">Deposits</field>
        <field name="res_model">hotel.deposit</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Task 7: Folio merged into Reservations (room_booking_menu). -->
    <menuitem id="hotel_deposit_menu"
              name="Deposits"
              sequence="30"
              parent="room_booking_menu"
              action="hotel_deposit_action"/>

    <record id="hotel_city_ledger_view_list" model="ir.ui.view">
        <field name="name">hotel.city.ledger.view.list</field>
        <field name="model">hotel.city.ledger</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="folio_id"/>
                <field name="amount"/>
                <field name="state"/>
                <field name="transfer_date"/>
                <field name="due_date"/>
                <field name="age_days"/>
            </list>
        </field>
    </record>

    <record id="hotel_city_ledger_view_form" model="ir.ui.view">
        <field name="name">hotel.city.ledger.view.form</field>
        <field name="model">hotel.city.ledger</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="folio_id"/>
                            <field name="amount"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="transfer_date"/>
                            <field name="due_date"/>
                            <field name="age_days"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="hotel_city_ledger_action" model="ir.actions.act_window">
        <field name="name">City Ledger</field>
        <field name="res_model">hotel.city.ledger</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Task 7: Folio merged into Reservations (room_booking_menu). -->
    <menuitem id="hotel_city_ledger_menu"
              name="City Ledger"
              sequence="40"
              parent="room_booking_menu"
              action="hotel_city_ledger_action"/>

    <!-- Task-4 intermediate menu, now empty (action moved above). No-op
         on fresh installs (Odoo logs a warning for missing deletes). -->
    <delete model="ir.ui.menu" id="hotel_folio_menu"/>
</odoo>
