    <template id="report_hotel_occupancy">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2><t t-out="title"/></h2>
                    <p><t t-out="company"/> — <t t-out="date_from"/> to <t t-out="date_to"/></p>
                    <table class="table">
                        <thead><tr><t t-foreach="columns" t-as="col"><th><t t-out="col['label']"/></th></t></tr></thead>
                        <tbody><t t-foreach="rows" t-as="row"><tr><t t-foreach="columns" t-as="col"><td><t t-out="row[col['key']]"/></td></t></tr></t></tbody>
                    </table>
                    <p>Occupied nights: <t t-out="totals.get('occupied_nights', 0)"/> — Rooms occupied: <t t-out="totals.get('rooms_occupied', 0)"/></p>
                </div>
            </t>
        </t>
    </template>

