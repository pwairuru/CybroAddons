<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report action for computed bill report -->
    <record id="action_report_combined_bill" model="ir.actions.report">
        <field name="name">Combined Bill</field>
        <field name="model">compute.bill</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hotel_management_odoo.report_combined_bill</field>
<!--        <field name="report_file">hotel_management_odoo.report_combined_bill</field>-->
        <field name="print_report_name">('%s - %s' % ('Combined Bill' if object.bill_type == 'combined' else 'Isolated Bill', object.booking_id.name))</field>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">report</field>
    </record>
    <!-- QWeb template for combined and isolated bill report -->
    <template id="report_combined_bill">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="oe_structure"/>
                        
                        <div class="row mt32">
                            <div class="col-12 text-center">
                                <h2 style="font-size: 28px; color: #000; font-weight: bold;">
                                    Computed Bill Invoice
                                </h2>
                            </div>
                        </div>

                        <div class="row mt16">
                            <div class="col-12">
                                <h3 style="font-size: 24px;">
                                    Booking # <span t-field="o.booking_id.name"/>
                                </h3>
                            </div>
                        </div>

                        <div class="row mt16 mb32" style="border-top: 1px solid #EEE; padding-top: 10px;">
                            <div class="col-3">
                                <strong>Check In Date:</strong><br/>
                                <span t-field="o.booking_id.checkin_date" t-options='{"widget": "date"}'/>
                            </div>
                            <div class="col-3">
                                <strong>Check out Date:</strong><br/>
                                <span t-field="o.booking_id.checkout_date" t-options='{"widget": "date"}'/>
                            </div>
                            <div class="col-3">
                                <strong>Manager:</strong><br/>
                                <span t-field="o.booking_id.invoice_address_id.name"/>
                            </div>
                            <div class="col-3 text-right">
                                <strong>Customer:</strong><br/>
                                <span t-field="o.partner_id.name"/>
                            </div>
                        </div>

                        <!-- Combined Bill: itemized groups (Rooms / Food / Services / Fleet / Events / POS Orders) -->
                        <t t-if="o.bill_type == 'combined'">
                            <t t-set="bill_groups" t-value="o.booking_id.get_bill_grouped_lines()"/>
                            <t t-foreach="bill_groups" t-as="g">
                                <h3 style="color: #666; margin-top: 20px; margin-bottom: 10px;"><span t-out="g['label']"/></h3>
                                <div style="margin-bottom: 10px;">
                                    <table class="table table-sm" style="border: 1px solid #000;">
                                        <thead>
                                            <tr style="border-bottom: 2px solid #000;">
                                                <th style="border-right: 1px solid #000;">Description</th>
                                                <th style="border-right: 1px solid #000;">Detail / Counter</th>
                                                <th style="border-right: 1px solid #000;">Date</th>
                                                <th class="text-right" style="border-right: 1px solid #000;">Qty</th>
                                                <th class="text-right" style="border-right: 1px solid #000;">Unit Price</th>
                                                <th class="text-right">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="g['rows']" t-as="r">
                                                <tr>
                                                    <td style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['description']"/></td>
                                                    <td style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['detail']"/></td>
                                                    <td style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['date']" t-options='{"widget": "datetime"}'/></td>
                                                    <td class="text-right" style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['qty']"/></td>
                                                    <td class="text-right" style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['unit']" t-options='{"widget": "monetary", "display_currency": o.booking_id.currency_id}'/></td>
                                                    <td class="text-right" style="border-bottom: 1px solid #000;"><span t-out="r['total']" t-options='{"widget": "monetary", "display_currency": o.booking_id.currency_id}'/></td>
                                                </tr>
                                            </t>
                                            <tr>
                                                <td colspan="5" class="text-right" style="border-top: 2px solid #000;"><strong><span t-out="g['label']"/> Subtotal</strong></td>
                                                <td class="text-right" style="border-top: 2px solid #000;">
                                                    <strong><span t-out="g['subtotal']" t-options='{"widget": "monetary", "display_currency": o.booking_id.currency_id}'/></strong>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </t>

                            <div class="row justify-content-end mt16">
                                <div class="col-4">
                                    <table class="table table-sm">
                                        <tr class="border-black">
                                            <td style="font-size: 18px;"><strong>Grand Total</strong></td>
                                            <td class="text-right" style="font-size: 18px;">
                                                <strong><span t-out="o.booking_id.get_bill_summary_total()" t-options='{"widget": "monetary", "display_currency": o.booking_id.currency_id}'/></strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </t>

                        <!-- Isolated Bill -->
                        <t t-else="">
                            <!-- Folio Page: itemized non-POS groups -->
                            <h3 style="color: #666; margin-bottom: 20px;">Isolated Bill - Folio</h3>
                            <t t-set="folio_groups" t-value="[g for g in o.booking_id.get_bill_grouped_lines() if g['label'] != 'POS Orders']"/>
                            <t t-set="folio_only_total" t-value="sum(g['subtotal'] for g in folio_groups)"/>
                            <t t-foreach="folio_groups" t-as="g">
                                <h4 style="color: #666; margin-top: 16px; margin-bottom: 8px;"><span t-out="g['label']"/></h4>
                                <div style="margin-bottom: 10px;">
                                    <table class="table table-sm" style="border: 1px solid #000;">
                                        <thead>
                                            <tr style="border-bottom: 2px solid #000;">
                                                <th style="border-right: 1px solid #000;">Description</th>
                                                <th style="border-right: 1px solid #000;">Detail</th>
                                                <th style="border-right: 1px solid #000;">Date</th>
                                                <th class="text-right" style="border-right: 1px solid #000;">Qty</th>
                                                <th class="text-right" style="border-right: 1px solid #000;">Unit Price</th>
                                                <th class="text-right">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="g['rows']" t-as="r">
                                                <tr>
                                                    <td style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['description']"/></td>
                                                    <td style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['detail']"/></td>
                                                    <td style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['date']" t-options='{"widget": "datetime"}'/></td>
                                                    <td class="text-right" style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['qty']"/></td>
                                                    <td class="text-right" style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="r['unit']" t-options='{"widget": "monetary", "display_currency": o.booking_id.currency_id}'/></td>
                                                    <td class="text-right" style="border-bottom: 1px solid #000;"><span t-out="r['total']" t-options='{"widget": "monetary", "display_currency": o.booking_id.currency_id}'/></td>
                                                </tr>
                                            </t>
                                            <tr>
                                                <td colspan="5" class="text-right" style="border-top: 2px solid #000;"><strong><span t-out="g['label']"/> Subtotal</strong></td>
                                                <td class="text-right" style="border-top: 2px solid #000;">
                                                    <strong><span t-out="g['subtotal']" t-options='{"widget": "monetary", "display_currency": o.booking_id.currency_id}'/></strong>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </t>
                            <div class="row justify-content-end mt16">
                                <div class="col-4">
                                    <table class="table table-sm">
                                        <tr class="border-black">
                                            <td style="font-size: 18px;"><strong>Folio Subtotal</strong></td>
                                            <td class="text-right" style="font-size: 18px;">
                                                <strong><span t-out="folio_only_total" t-options='{"widget": "monetary", "display_currency": o.booking_id.currency_id}'/></strong>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- POS Orders Page (if any) -->
                            <t t-if="o.pos_order_ids">
                                <p style="page-break-before:always;"/>
                                <h3 style="color: #666; margin-bottom: 20px;">Isolated Bill - POS Orders</h3>
                                <div style="margin-bottom: 30px;">
                                    <table class="table table-sm mt32" style="border: 1px solid #000;">
                                        <thead>
                                            <tr style="border-bottom: 2px solid #000;">
                                                <th style="border-right: 1px solid #000;">Receipt</th>
                                                <th style="border-right: 1px solid #000;">Counter</th>
                                                <th style="border-right: 1px solid #000;">Order Date</th>
                                                <th class="text-right">Total Price</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="o.pos_order_ids" t-as="line">
                                                <tr>
                                                    <td style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-field="line.pos_reference"/></td>
                                                    <td style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-out="line.session_id.config_id.name or line.session_id.name or 'POS'"/></td>
                                                    <td style="border-right: 1px solid #000; border-bottom: 1px solid #000;"><span t-field="line.date_order" t-options='{"widget": "datetime"}'/></td>
                                                    <td class="text-right" style="border-bottom: 1px solid #000;"><span t-field="line.amount_total"/></td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>
                                <div class="row justify-content-end mt16">
                                    <div class="col-4">
                                        <table class="table table-sm">
                                            <tr class="border-black">
                                                <td style="font-size: 18px;"><strong>POS Subtotal</strong></td>
                                                <td class="text-right" style="font-size: 18px;">
                                                    <strong><span t-out="sum(o.pos_order_ids.mapped('amount_total'))" t-options='{"widget": "monetary", "display_currency": o.booking_id.currency_id}'/></strong>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
