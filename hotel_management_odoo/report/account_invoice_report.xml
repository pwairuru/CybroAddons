<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_invoice_document_hotel_meal"
              inherit_id="account.report_invoice_document">
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_hotel_meal" class="text-start text-nowrap" t-if="o.hotel_folio_id" style="min-width: 140px;"><span>Meal</span></th>
        </xpath>
        <xpath expr="//td[@name='account_invoice_line_name']" position="after">
            <td name="td_hotel_meal" class="text-start text-nowrap" t-if="o.hotel_folio_id" style="min-width: 140px;">
                <span t-field="line.hotel_meal_plan"/>
            </td>
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="before">
            <t t-if="o.hotel_folio_id or o.hotel_booking_id">
                <!-- Deposit summary: folio deposits net the displayed due.
                     Source of truth is the folio statement; the invoice
                     itself stays gross (no negative revenue lines). -->
                <div style="clear: both;" class="mt-3" t-if="o.hotel_folio_id and o.hotel_folio_id.deposit_total">
                    <table class="o_total_table table table-borderless" name="hotel_deposit_table">
                        <tr class="o_subtotal">
                            <td><strong>Deposits paid</strong></td>
                            <td class="text-end o_price_total">
                                <span t-field="o.hotel_folio_id.deposit_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr class="o_subtotal">
                            <td><strong>Paid (incl. deposits)</strong></td>
                            <td class="text-end o_price_total">
                                <span t-field="o.hotel_folio_id.amount_paid" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                        <tr class="o_total">
                            <td><strong>Balance Due (net of Deposit)</strong></td>
                            <td class="text-end o_price_total">
                                <span t-field="o.hotel_folio_id.amount_due" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                            </td>
                        </tr>
                    </table>
                </div>
                <!-- clear: the totals above float right; without this the
                     block wraps up beside the totals table. -->
                <div style="clear: both;">
                    <t t-call="hotel_management_odoo.paybill_block" company="o.company_id"/>
                    <t t-set="server_first" t-value="((o.invoice_user_id or o.create_uid).display_name or '').split(' ')[0]"/>
                    <t t-call="hotel_management_odoo.served_by_line" server_name="server_first"/>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
