        <field name="model_id" ref="model_cleaning_request"/>
        <field name="group_id" ref="hotel_management_odoo.hotel_group_admin"/>
        <field name="domain">[(1, '=', 1)]</field>
        <field name="operation">crud</field>
    </record>
    <!--    GUEST DOCS / LOYALTY RECORD RULES (Task 9 minimal)-->
    <!--    Reception sees only allowed-company rows; admin inherits via
            hotel_group_reception. Full portal/field matrix stays Task 11.-->
    <record id="hotel_document_rule_reception" model="ir.access">
        <field name="name">Guest documents: reception company scope</field>
        <field name="model_id" ref="model_hotel_document"/>
        <field name="group_id" ref="hotel_management_odoo.hotel_group_reception"/>
        <field name="domain">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="operation">crud</field>
    </record>
    <record id="hotel_loyalty_entry_rule_reception" model="ir.access">
