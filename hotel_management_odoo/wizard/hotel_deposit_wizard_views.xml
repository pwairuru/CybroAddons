<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hotel_deposit_wizard_view_form" model="ir.ui.view">
        <field name="name">hotel.deposit.wizard.view.form</field>
        <field name="model">hotel.deposit.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="folio_id"/>
                        <field name="amount"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                    </group>
                    <p class="text-muted">
                        Creates the deposit, collects it as a payment and
                        applies it in one step. The invoice balance drops
                        at once when one is already posted.
                    </p>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Take Deposit"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
