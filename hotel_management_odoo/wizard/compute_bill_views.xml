<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Record definition for the Compute Bill form view used to manage and display billing details,
     customer information, room charges, food services, POS orders, and other related service records in the system. -->
    <record id="view_compute_bill_form" model="ir.ui.view">
        <field name="name">compute.bill.form</field>
        <field name="model">compute.bill</field>
        <field name="arch" type="xml">
            <form string="Compute Bill">
                <sheet>
                    <group string="FOLIO DETAILS">
                        <group>
                            <field name="booking_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <!-- Slimmed: line/totals detail already lives on the
                         booking form summary; this dialog only picks
                         the print format. -->
                    <group>
                        <field name="bill_type" widget="radio" options="{'horizontal': true}"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_bill" string="Print" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
