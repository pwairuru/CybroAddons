<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="hotel_meal_plan_dp" model="hotel.meal.plan">
            <field name="code">DP</field>
            <field name="name">Day Pass</field>
            <field name="sequence">10</field>
            <field name="description">Use the room for half a day, then leave. No overnight stay.</field>
        </record>
        <record id="hotel_meal_plan_ro" model="hotel.meal.plan">
            <field name="code">RO</field>
            <field name="name">Room Only</field>
            <field name="sequence">20</field>
            <field name="description">Room only, no meals included.</field>
        </record>
        <record id="hotel_meal_plan_bb" model="hotel.meal.plan">
            <field name="code">BB</field>
            <field name="name">Bed &amp; Breakfast</field>
            <field name="sequence">30</field>
            <field name="description">Room with breakfast included.</field>
        </record>
        <record id="hotel_meal_plan_hb" model="hotel.meal.plan">
            <field name="code">HB</field>
            <field name="name">Half Board</field>
            <field name="sequence">40</field>
            <field name="description">Room with breakfast and one main meal (lunch or dinner).</field>
        </record>
        <record id="hotel_meal_plan_fb" model="hotel.meal.plan">
            <field name="code">FB</field>
            <field name="name">Full Board</field>
            <field name="sequence">50</field>
            <field name="description">Room with breakfast, lunch and dinner.</field>
        </record>
    </data>
</odoo>
