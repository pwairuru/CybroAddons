<?xml version="1.0" encoding="UTF-8" ?>
<template>
    <t t-name="HotelTapeChart">
        <div class="o_ahb_tape_chart">
            <div class="o_ahb_toolbar">
                <h4>Tape Chart</h4>
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.shift(-1)" title="Back">‹</button>
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.goToday()">Today</button>
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.shift(1)" title="Forward">›</button>
                <span class="o_ahb_axis btn-group btn-group-sm" role="group" aria-label="Group by">
                    <button t-att-class="'btn ' + (this.state.groupBy === 'floor' ? 'btn-secondary' : 'btn-outline-secondary')" t-on-click="() => this.setGroup('floor')">Floor</button>
                    <button t-att-class="'btn ' + (this.state.groupBy === 'room_type' ? 'btn-secondary' : 'btn-outline-secondary')" t-on-click="() => this.setGroup('room_type')">Room type</button>
                </span>
                <button class="btn btn-secondary btn-sm" t-on-click="() => this.load()" title="Refresh">⟳</button>
                <ul class="o_ahb_legend" aria-label="Colour key">
                    <li class="o_ahb_legend_caption">Key</li>
                    <li><i class="o_ahb_dot o_ahb_st_confirmed"/> Confirmed</li>
                    <li><i class="o_ahb_dot o_ahb_st_checked_in"/> In-house</li>
                    <li><i class="o_ahb_dot o_ahb_st_block"/> OOO</li>
                </ul>
                <select class="form-select form-select-sm o_ahb_days ms-auto" t-on-change="(e) => this.onDaysChange(e)">
                    <option value="7" t-att-selected="this.state.days === 7 ? 'selected' : false">7 days</option>
                    <option value="14" t-att-selected="this.state.days === 14 ? 'selected' : false">14 days</option>
                    <option value="28" t-att-selected="this.state.days === 28 ? 'selected' : false">28 days</option>
                </select>
            </div>
            <div class="o_ahb_scroll">
                <div class="o_ahb_grid" t-att-style="'grid-template-columns: 190px repeat(' + this.state.dates.length + ', minmax(74px, 1fr));'">
                    <div class="o_ahb_corner fw-bold" style="grid-row: 1; grid-column: 1;"><span>Rooms</span></div>
                    <t t-foreach="this.state.dates" t-as="d" t-key="d">
                        <div class="o_ahb_date_head" t-att-style="'grid-row: 1; grid-column: ' + this.colFor(d) + ';'">
                            <div class="small text-muted"><t t-out="this.headFor(d).dow"/></div><div class="fw-bold"><t t-out="this.headFor(d).day"/><small class="text-muted"> <t t-out="this.headFor(d).mon"/></small></div>
                        </div>
                    </t>
                    <div class="o_ahb_occ_label" style="grid-row: 2; grid-column: 1;"><span>Occupancy</span></div>
                    <t t-foreach="this.state.dates" t-as="d" t-key="'occ-' + d">
                        <div class="o_ahb_occ_cell" t-att-style="'grid-row: 2; grid-column: ' + this.colFor(d) + ';'"
                             t-att-title="(this.state.occupancy[d] ? this.state.occupancy[d].sold : 0) + '/' + (this.state.occupancy[d] ? this.state.occupancy[d].sellable : 0) + ' rooms sold'">
                            <div class="o_ahb_occ_bar"><div class="o_ahb_occ_fill" t-att-style="'width: ' + (this.state.occupancy[d] ? this.state.occupancy[d].pct : 0) + '%;'"/></div>
                            <small data-testid="tape-occ"><t t-out="(this.state.occupancy[d] ? this.state.occupancy[d].pct : 0) + '%'"/></small>
                        </div>
                    </t>
                    <t t-foreach="this.groupedRows()" t-as="entry" t-key="entry.type === 'group' ? 'g-' + entry.label : 'r-' + entry.room.id">
                        <t t-if="entry.type === 'group'">
                            <div class="o_ahb_floor_row fw-bold" t-att-style="'grid-row: ' + (entry_index + 3) + '; grid-column: 1 / -1;'"><span><t t-out="entry.label"/></span></div>
                        </t>
                        <t t-elif="entry.type === 'room'">
                            <div class="o_ahb_room_cell" t-att-style="'grid-row: ' + (entry_index + 3) + '; grid-column: 1;'" t-att-title="entry.room.name + ' · ' + entry.room.room_type_label + ' · ' + entry.room.hk_status">
                                <span class="fw-bold"><t t-out="entry.room.name"/></span>
                                <span class="o_ahb_hk_pill"><t t-out="entry.room.hk_status"/></span>
                            </div>
                            <t t-foreach="this.state.dates" t-as="d" t-key="'empty-' + entry.room.id + '-' + d">
                                <div class="o_ahb_empty" t-att-style="'grid-row: ' + (entry_index + 3) + '; grid-column: ' + this.colFor(d) + ';'"
                                     t-on-click="() => this.openNewBooking(entry.room.id, d)"
                                     t-att-data-testid="'tape-empty-' + entry.room.id + '-' + d" t-att-title="'New booking · Room ' + entry.room.name + ' · ' + d"/>
                            </t>
                            <t t-foreach="this.state.segments.filter((s) => s.room_id === entry.room.id)" t-as="seg" t-key="seg.id">
                                <div t-att-class="this.clsFor(seg)" t-att-style="'grid-row: ' + (entry_index + 3) + '; grid-column: ' + this.colFor(seg.date_from) + ' / span ' + this.spanFor(seg) + ';'"
                                     t-on-click="() => this.openBooking(seg.booking_id)" t-att-data-testid="'tape-seg-' + seg.id" t-att-title="seg.booking_name + ' · ' + seg.guest_name + ' · ' + seg.date_from + ' → ' + seg.date_to">
                                    <span class="o_ahb_seg_label"><t t-out="seg.guest_name"/></span>
                                </div>
                            </t>
                        </t>
                    </t>
                </div>
            </div>
        </div>
    </t>
</template>
