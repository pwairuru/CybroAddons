        <!-- ── Food Section ── -->
        <div class="dash-section-title">Food</div>
        <div class="dash-grid">

            <!-- Food Items -->
            <div class="dash-card" t-on-click="(e) => this.fetch_food_item(e)">
                <div class="dash-icon-bubble icon-amber">
                    <i class="oi" data-icon="restaurant"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Food Items</div>
                    <div class="dash-count"><t t-out="this.food_items"/></div>
                </div>
            </div>

            <!-- Food Orders -->
            <div class="dash-card" t-on-click="(e) => this.fetch_food_order(e)">
                <div class="dash-icon-bubble icon-rose">
                    <i class="oi" data-icon="shopping_cart"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Food Orders</div>
                    <div class="dash-count"><t t-out="this.food_order"/></div>
                </div>
            </div>

        </div>

