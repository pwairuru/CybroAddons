<?xml version="1.0" encoding="UTF-8" ?>
<!--Dashboard template-->
<template>
    <t t-name="CustomDashBoard">
        <div class="oh_dashboards">
            <div class="container-fluid o_pj_dashboard">
                <t t-call="HotelOrder"/>
            </div>
        </div>
    </t>

    <t t-name="HotelOrder">
        <!-- ── Today at a Glance (Task 4: occupancy/ADR/RevPAR/arrivals/departures/dirty) ── -->
        <div class="dash-section-title">Today at a Glance</div>
        <div class="dash-grid dash-grid-tiles">
            <div class="dash-card tile-occupancy" data-testid="tile-occupancy" t-on-click="(e) => this.openOccupancy(e)">
                <div class="dash-icon-bubble icon-teal">
                    <i class="oi" data-icon="bed"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Occupancy</div>
                    <div class="dash-count"><t t-out="this.occupancy"/></div>
                </div>
            </div>
            <div class="dash-card tile-adr" data-testid="tile-adr">
                <div class="dash-icon-bubble icon-blue">
                    <i class="oi" data-icon="payments"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">ADR</div>
                    <div class="dash-count"><t t-out="this.adr"/></div>
                </div>
            </div>
            <div class="dash-card tile-revpar" data-testid="tile-revpar">
                <div class="dash-icon-bubble icon-purple">
                    <i class="oi" data-icon="monitoring"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">RevPAR</div>
                    <div class="dash-count"><t t-out="this.revpar"/></div>
                </div>
            </div>
            <div class="dash-card tile-arrivals" data-testid="tile-arrivals" t-on-click="(e) => this.openArrivals(e)">
                <div class="dash-icon-bubble icon-green">
                    <i class="oi" data-icon="login"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Arrivals</div>
                    <div class="dash-count"><t t-out="this.arrivals"/></div>
                </div>
            </div>
            <div class="dash-card tile-departures" data-testid="tile-departures" t-on-click="(e) => this.openDepartures(e)">
                <div class="dash-icon-bubble icon-orange">
                    <i class="oi" data-icon="logout"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Departures</div>
                    <div class="dash-count"><t t-out="this.departures"/></div>
                </div>
            </div>
            <div class="dash-card tile-dirty" data-testid="tile-dirty" t-on-click="(e) => this.openDirty(e)">
                <div class="dash-icon-bubble icon-red">
                    <i class="oi" data-icon="warning"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Dirty Rooms</div>
                    <div class="dash-count"><t t-out="this.dirty"/></div>
                </div>
            </div>
        </div>

        <!-- ── Rooms Section ── -->
        <div class="dash-section-title">Rooms</div>
        <div class="dash-grid">

            <!-- Total Rooms -->
            <div class="dash-card" t-on-click="(e) => this.total_rooms(e)">
                <div class="dash-icon-bubble icon-blue">
                    <i class="oi" data-icon="bed"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Total Rooms</div>
                    <div class="dash-count"><t t-out="this.total_room"/></div>
                </div>
            </div>

            <!-- Available Rooms -->
            <div class="dash-card" t-on-click="(e) => this.available_rooms(e)">
                <div class="dash-icon-bubble icon-green">
                    <i class="oi" data-icon="check_circle"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Available Rooms</div>
                    <div class="dash-count"><t t-out="this.available_room"/></div>
                </div>
            </div>

            <!-- Check In -->
            <div class="dash-card" t-on-click="(e) => this.check_ins(e)">
                <div class="dash-icon-bubble icon-teal">
                    <i class="oi" data-icon="login"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Check In</div>
                    <div class="dash-count"><t t-out="this.check_in"/></div>
                </div>
            </div>

            <!-- Today's Check Out -->
            <div class="dash-card" t-on-click="(e) => this.check_outs(e)">
                <div class="dash-icon-bubble icon-orange">
                    <i class="oi" data-icon="logout"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Today's Check Out</div>
                    <div class="dash-count"><t t-out="this.check_out"/></div>
                </div>
            </div>

            <!-- Total Reservations -->
            <div class="dash-card" t-on-click="(e) => this.reservations(e)">
                <div class="dash-icon-bubble icon-purple">
                    <i class="oi" data-icon="bookmark"/>
                </div>
                <div class="dash-card-body">
                    <div class="dash-label">Total Reservations</div>
                    <div class="dash-count"><t t-out="this.reservation"/></div>
                </div>
            </div>

        </div>

        <div class="dash-section-title">Tape Chart</div>
        <div class="tape-embed"><HotelTapeChart/></div>

