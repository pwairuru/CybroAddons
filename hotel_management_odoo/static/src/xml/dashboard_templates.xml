<?xml version="1.0" encoding="UTF-8" ?>
<!--POS-style condensed dashboard: one register-like card per area,
    each with 3-4 stats, an interactive Chart.js in-card chart (same
    look as point_of_sale kanban_dashboard_graph) and a 3-dot menu
    to list/pivot/graph.-->
<template>
    <t t-name="CustomDashBoard">
        <div class="oh_dashboards">
            <div class="container-fluid o_pj_dashboard">
                <t t-call="HotelOrder"/>
            </div>
        </div>
    </t>

    <t t-name="PosCardChart">
        <div class="pos-chart"><canvas t-ref="this.chart.ref"/></div>
    </t>

    <t t-name="HotelOrder">
        <div class="dash-section-title">Today at a Glance</div>
        <div class="pos-grid">
            <!-- Occupancy -->
            <div class="pos-card" data-testid="tile-occupancy">
                <div class="pos-card-head">
                    <div class="pos-card-title">
                        <div class="dash-icon-bubble icon-teal"><i class="oi" data-icon="bed"/></div>
                        <span>Occupancy</span>
                    </div>
                    <div class="pos-menu-wrap">
                        <button class="pos-dots" title="Reports" aria-label="Occupancy reports" t-on-click="(e) => this.toggleMenu(e, 'occupancy')">⋮</button>
                        <div class="pos-menu" t-if="this.ui.menu === 'occupancy'">
                            <button t-on-click="(e) => this.openOccupancy(e)">In-House list</button>
                            <button t-on-click="(e) => this.openBookingPivot(e)">Reservations pivot</button>
                            <button t-on-click="(e) => this.openBookingGraph(e)">Reservations graph</button>
                            <button t-on-click="(e) => this.openLinePivot(e)">Room nights pivot</button>
                        </div>
                    </div>
                </div>
                <div class="pos-card-body" t-on-click="(e) => this.openOccupancy(e)">
                    <div class="pos-main"><t t-out="this.occupancy"/></div>
                    <div class="pos-rows">
                        <div class="pos-row"><span>In-house</span><strong><t t-out="this.occupied"/> of <t t-out="this.sellable"/></strong></div>
                        <div class="pos-row"><span>Reserved · Dirty</span><strong><t t-out="this.reservedCount"/> · <t t-out="this.dirty"/></strong></div>
                    </div>
                    <PosCardChart values="this.seriesOccupancy" labels="this.seriesDates" color="'#14b8a6'" label="'Occupancy %'"/>
                </div>
                <div class="pos-card-foot"><button t-on-click="(e) => this.openOccupancy(e)">In-House list</button></div>
            </div>

            <!-- Rates -->
            <div class="pos-card" data-testid="tile-adr">
                <div class="pos-card-head">
                    <div class="pos-card-title">
                        <div class="dash-icon-bubble icon-blue"><i class="oi" data-icon="payments"/></div>
                        <span>Rates</span>
                    </div>
                    <div class="pos-menu-wrap">
                        <button class="pos-dots" title="Reports" aria-label="Rate reports" t-on-click="(e) => this.toggleMenu(e, 'rates')">⋮</button>
                        <div class="pos-menu" t-if="this.ui.menu === 'rates'">
                            <button t-on-click="(e) => this.openBookingPivot(e)">Revenue pivot</button>
                            <button t-on-click="(e) => this.openBookingGraph(e)">Revenue graph</button>
                            <button t-on-click="(e) => this.openLineGraph(e)">Nights graph</button>
                        </div>
                    </div>
                </div>
                <div class="pos-card-body" t-on-click="(e) => this.openBookingPivot(e)">
                    <div class="pos-main"><t t-out="this.adr"/></div>
                    <div class="pos-rows">
                        <div class="pos-row"><span>RevPAR</span><strong><t t-out="this.revpar"/></strong></div>
                        <div class="pos-row"><span>Room revenue today</span><strong><t t-out="this.roomRevenueToday"/></strong></div>
                    </div>
                    <PosCardChart values="this.seriesRevpar" labels="this.seriesDates" color="'#3b82f6'" label="'RevPAR'"/>
                </div>
                <div class="pos-card-foot"><button t-on-click="(e) => this.openBookingPivot(e)">Revenue pivot</button></div>
            </div>

            <!-- Front desk -->
            <div class="pos-card" data-testid="tile-arrivals">
                <div class="pos-card-head">
                    <div class="pos-card-title">
                        <div class="dash-icon-bubble icon-green"><i class="oi" data-icon="login"/></div>
                        <span>Front Desk</span>
                    </div>
                    <div class="pos-menu-wrap">
                        <button class="pos-dots" title="Reports" aria-label="Front desk reports" t-on-click="(e) => this.toggleMenu(e, 'frontdesk')">⋮</button>
                        <div class="pos-menu" t-if="this.ui.menu === 'frontdesk'">
                            <button t-on-click="(e) => this.openArrivals(e)">Arrivals list</button>
                            <button t-on-click="(e) => this.openDepartures(e)">Departures list</button>
                            <button t-on-click="(e) => this.reservations(e)">Reservations list</button>
                            <button t-on-click="(e) => this.openBookingGraph(e)">Reservations graph</button>
                        </div>
                    </div>
                </div>
                <div class="pos-card-body" t-on-click="(e) => this.openArrivals(e)">
                    <div class="pos-main"><t t-out="this.arrivals"/> / <t t-out="this.departures"/></div>
                    <div class="pos-rows">
                        <div class="pos-row"><span>Arrivals / Departures</span><strong><t t-out="this.arrivals"/> / <t t-out="this.departures"/></strong></div>
                        <div class="pos-row"><span>In-house · Reserved</span><strong><t t-out="this.check_in"/> · <t t-out="this.reservation"/></strong></div>
                    </div>
                    <PosCardChart values="this.seriesArrivals" labels="this.seriesDates" color="'#22c55e'" label="'Arrivals'" values2="this.seriesDepartures" color2="'#f97316'" label2="'Departures'"/>
                </div>
                <div class="pos-card-foot"><button t-on-click="(e) => this.openArrivals(e)">Arrivals list</button></div>
            </div>

            <!-- Rooms -->
            <div class="pos-card" data-testid="tile-rooms">
                <div class="pos-card-head">
                    <div class="pos-card-title">
                        <div class="dash-icon-bubble icon-purple"><i class="oi" data-icon="bookmark"/></div>
                        <span>Rooms</span>
                    </div>
                    <div class="pos-menu-wrap">
                        <button class="pos-dots" title="Reports" aria-label="Room reports" t-on-click="(e) => this.toggleMenu(e, 'rooms')">⋮</button>
                        <div class="pos-menu" t-if="this.ui.menu === 'rooms'">
                            <button t-on-click="(e) => this.total_rooms(e)">All rooms</button>
                            <button t-on-click="(e) => this.available_rooms(e)">Available rooms</button>
                            <button t-on-click="(e) => this.openDirty(e)">Dirty rooms</button>
                            <button t-on-click="(e) => this.openLinePivot(e)">Room nights pivot</button>
                        </div>
                    </div>
                </div>
                <div class="pos-card-body" t-on-click="(e) => this.total_rooms(e)">
                    <div class="pos-main"><t t-out="this.available_room"/> / <t t-out="this.total_room"/></div>
                    <div class="pos-rows">
                        <div class="pos-row"><span>Available / Total</span><strong><t t-out="this.available_room"/> / <t t-out="this.total_room"/></strong></div>
                        <div class="pos-row"><span>Dirty · OOO</span><strong><t t-out="this.dirty"/> · <t t-out="this.oooCount"/></strong></div>
                    </div>
                    <PosCardChart values="this.seriesAvailable" labels="this.seriesDates" color="'#a855f7'" label="'Available'"/>
                </div>
                <div class="pos-card-foot"><button t-on-click="(e) => this.available_rooms(e)">Available rooms</button></div>
            </div>

            <!-- Revenue & Folios -->
            <div class="pos-card" data-testid="tile-revenue">
                <div class="pos-card-head">
                    <div class="pos-card-title">
                        <div class="dash-icon-bubble icon-orange"><i class="oi" data-icon="monitoring"/></div>
                        <span>Revenue</span>
                    </div>
                    <div class="pos-menu-wrap">
                        <button class="pos-dots" title="Reports" aria-label="Revenue reports" t-on-click="(e) => this.toggleMenu(e, 'revenue')">⋮</button>
                        <div class="pos-menu" t-if="this.ui.menu === 'revenue'">
                            <button t-on-click="(e) => this.openFolioList(e)">Open folios</button>
                            <button t-on-click="(e) => this.openFolioPivot(e)">Folio pivot</button>
                            <button t-on-click="(e) => this.openFolioGraph(e)">Folio graph</button>
                            <button t-on-click="(e) => this.openLinePivot(e)">Room nights pivot</button>
                        </div>
                    </div>
                </div>
                <div class="pos-card-body" t-on-click="(e) => this.openFolioList(e)">
                    <div class="pos-main"><t t-out="this.today_revenue"/></div>
                    <div class="pos-rows">
                        <div class="pos-row"><span>Total paid</span><strong><t t-out="this.total_revenue"/></strong></div>
                        <div class="pos-row"><span>Pending · Open folios</span><strong><t t-out="this.pending_payment"/> · <t t-out="this.openFolios"/></strong></div>
                    </div>
                    <PosCardChart values="this.seriesRevenue" labels="this.seriesDates" color="'#f97316'" label="'Room revenue'"/>
                </div>
                <div class="pos-card-foot"><button t-on-click="(e) => this.openFolioList(e)">Open folios</button></div>
            </div>

            <!-- Food -->
            <div class="pos-card" data-testid="tile-food">
                <div class="pos-card-head">
                    <div class="pos-card-title">
                        <div class="dash-icon-bubble icon-amber"><i class="oi" data-icon="restaurant"/></div>
                        <span>Food</span>
                    </div>
                    <div class="pos-menu-wrap">
                        <button class="pos-dots" title="Reports" aria-label="Food reports" t-on-click="(e) => this.toggleMenu(e, 'food')">⋮</button>
                        <div class="pos-menu" t-if="this.ui.menu === 'food'">
                            <button t-on-click="(e) => this.fetch_food_item(e)">Food items</button>
                            <button t-on-click="(e) => this.fetch_food_order(e)">Food orders</button>
                        </div>
                    </div>
                </div>
                <div class="pos-card-body" t-on-click="(e) => this.fetch_food_order(e)">
                    <div class="pos-main"><t t-out="this.food_order"/></div>
                    <div class="pos-rows">
                        <div class="pos-row"><span>Open orders</span><strong><t t-out="this.food_order"/></strong></div>
                        <div class="pos-row"><span>Menu items</span><strong><t t-out="this.food_items"/></strong></div>
                    </div>
                    <PosCardChart values="this.seriesFood" labels="this.seriesDates" color="'#f59e0b'" label="'Food orders'" kind="'bar'"/>
                </div>
                <div class="pos-card-foot"><button t-on-click="(e) => this.fetch_food_order(e)">Food orders</button></div>
            </div>
        </div>

        <div class="dash-section-title">Tape Chart <button class="btn btn-sm btn-outline-secondary tape-expand-btn" data-testid="tape-expand" title="Open full tape chart" aria-label="Open full tape chart" t-on-click="(e) => this.openTapeFull(e)">⤢</button></div>
        <div class="tape-embed"><HotelTapeChart/></div>
    </t>
</template>
